{
  "version": "2026-05-22",
  "policy": {
    "warning_burn_rate_threshold": 6,
    "critical_burn_rate_threshold": 14.4,
    "min_traffic_rate_1h": 0.01,
    "min_traffic_rate_6h": 0.01,
    "release_rules": {
      "allow": ["standard", "low_risk", "mitigation"],
      "restricted": ["low_risk", "mitigation"],
      "freeze": ["mitigation"]
    }
  },
  "scenarios": [
    {
      "id": "healthy_within_budget",
      "input": {
        "burnRate5m": 1.1,
        "burnRate1h": 1.05,
        "burnRate30m": 1.0,
        "burnRate6h": 1.0,
        "requestsRate1h": 0.3,
        "requestsRate6h": 0.3
      },
      "change_class": "standard",
      "expected_decision": "allow",
      "expected_gate": "pass"
    },
    {
      "id": "warning_burn_blocks_standard_release",
      "input": {
        "burnRate5m": 4.0,
        "burnRate1h": 4.2,
        "burnRate30m": 6.4,
        "burnRate6h": 6.3,
        "requestsRate1h": 0.4,
        "requestsRate6h": 0.4
      },
      "change_class": "standard",
      "expected_decision": "restricted",
      "expected_gate": "block"
    },
    {
      "id": "warning_burn_allows_low_risk_fix",
      "input": {
        "burnRate5m": 4.0,
        "burnRate1h": 4.2,
        "burnRate30m": 6.4,
        "burnRate6h": 6.3,
        "requestsRate1h": 0.4,
        "requestsRate6h": 0.4
      },
      "change_class": "low_risk",
      "expected_decision": "restricted",
      "expected_gate": "pass"
    },
    {
      "id": "critical_burn_blocks_low_risk_fix",
      "input": {
        "burnRate5m": 15.2,
        "burnRate1h": 15.0,
        "burnRate30m": 8.0,
        "burnRate6h": 7.5,
        "requestsRate1h": 0.5,
        "requestsRate6h": 0.5
      },
      "change_class": "low_risk",
      "expected_decision": "freeze",
      "expected_gate": "block"
    },
    {
      "id": "critical_burn_allows_mitigation",
      "input": {
        "burnRate5m": 15.2,
        "burnRate1h": 15.0,
        "burnRate30m": 8.0,
        "burnRate6h": 7.5,
        "requestsRate1h": 0.5,
        "requestsRate6h": 0.5
      },
      "change_class": "mitigation",
      "expected_decision": "freeze",
      "expected_gate": "pass"
    },
    {
      "id": "low_traffic_allow",
      "input": {
        "burnRate5m": 50,
        "burnRate1h": 50,
        "burnRate30m": 50,
        "burnRate6h": 50,
        "requestsRate1h": 0.001,
        "requestsRate6h": 0.001
      },
      "change_class": "standard",
      "expected_decision": "allow",
      "expected_gate": "pass"
    }
  ]
}
